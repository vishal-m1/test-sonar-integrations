{
  "id": "mT2nuqc40wefhAMQ",
  "name": "Notifications - Telegram Message - Email & Google Sheets",
  "active": false,
  "isArchived": false,
  "versionId": "f493fee7-9227-409b-92d4-1be0b3ddd3d1",
  "settings": { "executionOrder": "v1", "availableInMCP": true },
  "connections": {
    "Telegram - New Message": { "main": [[{"node": "Format Message Data", "type": "main", "index": 0}]] },
    "Format Message Data": { "main": [ [{"node": "Gmail - Send Email", "type": "main", "index": 0}], [{"node": "Google Sheets - Log Message", "type": "main", "index": 0}] ] }
  },
  "nodes": [
    { "id": "89b7c7a5-5de4-47b1-a8a6-5cf70ec9d59c", "name": "Telegram - New Message", "type": "n8n-nodes-base.telegramTrigger", "typeVersion": 1.3, "position": [0, 96], "parameters": { "updates": ["message"], "additionalFields": {} }, "webhookId": "abc355d5-20f3-4099-bb8f-21fd7193a3fd" },
    { "id": "272961af-1675-40df-aa91-fb55bc898935", "name": "Format Message Data", "type": "n8n-nodes-base.set", "typeVersion": 3.4, "position": [224, 96], "parameters": { "mode": "manual", "duplicateItem": false, "fields": { "values": [ {"name": "sender_name", "type": "string", "stringValue": "={{ $json.message.from.first_name }} {{ $json.message.from.last_name }}"}, {"name": "sender_username", "type": "string", "stringValue": "={{ $json.message.from.username }}"}, {"name": "sender_id", "type": "string", "stringValue": "={{ $json.message.from.id }}"}, {"name": "message_text", "type": "string", "stringValue": "={{ $json.message.text }}"}, {"name": "chat_id", "type": "string", "stringValue": "={{ $json.message.chat.id }}"}, {"name": "received_at", "type": "string", "stringValue": "={{ new Date($json.message.date * 1000).toISOString() }}"}, {"name": "message_id", "type": "string", "stringValue": "={{ $json.message.message_id }}"} ] } } },
    { "id": "352f9152-f3fd-415f-a26a-4b7b50a4884e", "name": "Gmail - Send Email", "type": "n8n-nodes-base.gmail", "typeVersion": 2.2, "position": [448, 0], "parameters": { "resource": "message", "operation": "send", "sendTo": "vishalm@devsavant.com", "subject": "=\ud83d\udce9 Telegram Message from {{ $json.sender_name }}", "emailType": "html", "message": "=<h2>New Telegram Message</h2>", "options": { "appendAttribution": false, "senderName": "n8n Telegram Bot" } } },
    { "id": "6775ba63-5d26-4361-8bd7-abdc0daabd91", "name": "Google Sheets - Log Message", "type": "n8n-nodes-base.googleSheets", "typeVersion": 4.7, "position": [448, 192], "parameters": { "resource": "sheet", "operation": "append", "documentId": {"__rl": true, "mode": "id", "value": "YOUR_GOOGLE_SHEET_ID"}, "sheetName": {"__rl": true, "mode": "name", "value": "Telegram Messages"}, "columns": "={{ $json }}", "options": {"cellFormat": "USER_ENTERED"} } }
  ],
  "tags": [],
  "meta": { "aiBuilderAssisted": true, "builderVariant": "mcp" },
  "description": "Triggers on every incoming Telegram message, forwards full message details to email via Gmail, and simultaneously logs the message to a Google Sheet."
}