{"id":"0H6Y3rSCTxia3PaW","name":"News - Summarise Google News - Email & Telegram","active":false,"isArchived":false,"versionId":"ecae6684-2dc3-4e0b-afb4-6c4e913fb869","connections":{"Every Hour":{"main":[[{"node":"Fetch Google News RSS","type":"main","index":0}]]},"Fetch Google News RSS":{"main":[[{"node":"Extract Headlines","type":"main","index":0}]]},"Extract Headlines":{"main":[[{"node":"Summarise Headlines with GPT","type":"main","index":0}]]},"Summarise Headlines with GPT":{"main":[[{"node":"Format Summary","type":"main","index":0}]]},"OpenAI Chat Model":{"ai_languageModel":[[{"node":"Summarise Headlines with GPT","type":"ai_languageModel","index":0}]]},"Format Summary":{"main":[[{"node":"Send Email Summary","type":"main","index":0},{"node":"Send Telegram Summary","type":"main","index":0}]]},"Send Email Summary":{"main":[[{"node":"Wait for Both Sent","type":"main","index":0}]]},"Send Telegram Summary":{"main":[[{"node":"Wait for Both Sent","type":"main","index":1}]]}},"nodes":[{"id":"d06e5f67-c82e-4716-8fab-7e6541259521","name":"Every Hour","type":"n8n-nodes-base.scheduleTrigger","typeVersion":1.3,"position":[0,112],"parameters":{"rule":{"interval":[{"field":"hours","hoursInterval":1}]}}},{"id":"fa8e43e3-3bd5-4f4b-89e4-49a70a829daf","name":"Fetch Google News RSS","type":"n8n-nodes-base.httpRequest","typeVersion":4.4,"position":[224,112],"parameters":{"method":"GET","url":"https://news.google.com/rss","options":{"response":{"response":{"responseFormat":"text"}}}}},{"id":"5ada6d44-d6af-463a-9de4-67ab51c2dfe8","name":"Extract Headlines","type":"n8n-nodes-base.set","typeVersion":3.4,"position":[448,112],"parameters":{"mode":"manual","assignments":{"assignments":[{"id":"headlines-raw","name":"headlinesRaw","value":"={{ $json.data.match(/<title>(?!Google News)(.*?)<\\/title>/g)?.slice(0, 10).map(t => t.replace(/<\\/?title>/g, '')).join('\\n') || 'No headlines found' }}","type":"string"}]}}},{"id":"d0c4453b-887c-4976-b7a7-c03db1a70a0f","name":"Summarise Headlines with GPT","type":"@n8n/n8n-nodes-langchain.agent","typeVersion":3.1,"position":[672,112],"parameters":{"promptType":"define","text":"=Here are the latest Google News top headlines:\n\n{{ $json.headlinesRaw }}\n\nPlease provide a concise bullet-point summary of the top headlines. Keep it brief and informative."}},{"id":"cf93d065-f2d3-46ee-94f7-c0e69530dda4","name":"OpenAI Chat Model","type":"@n8n/n8n-nodes-langchain.lmChatOpenAi","typeVersion":1.3,"position":[752,336],"parameters":{}},{"id":"20569f96-816c-49e5-9e33-7841e6b85e3b","name":"Format Summary","type":"n8n-nodes-base.set","typeVersion":3.4,"position":[1024,112],"parameters":{"mode":"manual","assignments":{"assignments":[{"id":"summary-text","name":"summary","value":"={{ $json.output }}","type":"string"},{"id":"timestamp","name":"timestamp","value":"={{ $now.toFormat('yyyy-MM-dd HH:mm') }}","type":"string"}]}}},{"id":"8e5afca5-a805-4d91-81dc-b56321cdb4bf","name":"Send Email Summary","type":"n8n-nodes-base.gmail","typeVersion":2.2,"position":[1248,16],"parameters":{"resource":"message","operation":"send","sendTo":"gaurav.shakya@fulcrumapp.com","subject":"=Google News Summary — {{ $json.timestamp }}","emailType":"html","message":"=<h2>📰 Google News Top Headlines</h2><p><strong>Generated at:</strong> {{ $json.timestamp }}</p><hr/><p>{{ $json.summary.replace(/\\n/g, '<br/>') }}</p><hr/><p style=\"color:#888;font-size:12px;\">This summary was generated automatically.</p>","options":{"appendAttribution":false}}},{"id":"15a3d751-fb2e-4485-8c34-79f830ad693d","name":"Wait for Both Sent","type":"n8n-nodes-base.merge","typeVersion":3.2,"position":[1472,112],"parameters":{"mode":"combine","combineBy":"combineByPosition"}},{"id":"6ceff789-4048-4707-80a7-93b4b9be0b42","name":"Send Telegram Summary","type":"n8n-nodes-base.telegram","typeVersion":1.2,"position":[1248,208],"parameters":{"resource":"message","operation":"sendMessage","chatId":"@demo","text":"=📰 *Google News Summary* — {{ $json.timestamp }}\n\n{{ $json.summary }}","