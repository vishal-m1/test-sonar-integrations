{
  "id": "QBTrGynvj75pBVIW",
  "name": "Notifications - Daily Morning Standup - Slack",
  "active": false,
  "isArchived": false,
  "versionId": "8ba5dca2-9421-428a-b338-b6a8160059a0",
  "settings": {
    "executionOrder": "v1",
    "availableInMCP": true
  },
  "connections": {
    "Daily Morning Trigger": {
      "main": [[{"node": "Build Message", "type": "main", "index": 0}]]
    },
    "Build Message": {
      "main": [[{"node": "Send Slack Notification", "type": "main", "index": 0}]]
    }
  },
  "nodes": [
    {
      "id": "c3a6c6fa-77ae-4d1f-a2b9-885ebe9be9df",
      "name": "Daily Morning Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [0, 0],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 9,
              "triggerAtMinute": 0
            }
          ]
        }
      }
    },
    {
      "id": "7a6e77f5-7f93-480a-8f73-5f0386d13080",
      "name": "Build Message",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [224, 0],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            {
              "id": "msg-text",
              "name": "messageText",
              "value": "=🌅 Good morning, DevSavant team! Today is {{ $now.toFormat(\"cccc, LLLL d\") }}. Have a productive day! 🚀",
              "type": "string"
            },
            {
              "id": "triggered-at",
              "name": "triggeredAt",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "97b27d1d-faad-4513-b256-dd7e5a22c532",
      "name": "Send Slack Notification",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.5,
      "position": [448, 0],
      "parameters": {
        "resource": "message",
        "operation": "post",
        "authentication": "oAuth2",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "general"
        },
        "messageType": "text",
        "text": "={{ $json.messageText }}",
        "otherOptions": {
          "includeLinkToWorkflow": false,
          "mrkdwn": true
        }
      }
    }
  ],
  "meta": {
    "aiBuilderAssisted": true,
    "builderVariant": "mcp"
  },
  "description": "Sends a daily good morning message to the #general Slack channel every weekday at 9 AM. Keeps the team aligned and energised at the start of each day."
}
