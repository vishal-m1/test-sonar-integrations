{
  "id": "cV0mCRUtNF4qUVtD",
  "name": "Notifications - Daily Joke - Slack",
  "active": false,
  "isArchived": false,
  "versionId": "de91d70f-f25d-45c7-b787-bc6495873d3e",
  "settings": { "executionOrder": "v1", "availableInMCP": true },
  "connections": {
    "Daily 9am Trigger": { "main": [[{ "node": "Fetch Daily Joke", "type": "main", "index": 0 }]] },
    "Fetch Daily Joke": { "main": [[{ "node": "Format Slack Message", "type": "main", "index": 0 }]] },
    "Format Slack Message": { "main": [[{ "node": "Send to Slack", "type": "main", "index": 0 }]] }
  },
  "nodes": [
    {
      "id": "edcea43c-dc22-4f66-99e0-8f5c000d8188",
      "name": "Daily 9am Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [0, 0],
      "parameters": { "rule": { "interval": [{ "field": "days", "daysInterval": 1, "triggerAtHour": 9, "triggerAtMinute": 0 }] } }
    },
    {
      "id": "73af3f0f-3364-4495-b33e-2b343341d086",
      "name": "Fetch Daily Joke",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [224, 0],
      "parameters": { "method": "GET", "url": "https://official-joke-api.appspot.com/random_joke", "options": { "response": { "response": { "responseFormat": "json" } } } }
    },
    {
      "id": "85de69b1-a4f0-4a32-9a2f-559c419a6016",
      "name": "Format Slack Message",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [448, 0],
      "parameters": { "mode": "manual", "includeOtherFields": false, "assignments": { "assignments": [{ "id": "slack-message", "name": "message", "value": "=\ud83c\udf89 *Daily Joke* \ud83c\udf89\n\n*{{ $json.setup }}*\n\n{{ $json.punchline }}", "type": "string" }] } }
    },
    {
      "id": "deb8056d-0a50-4994-8e64-2a4677be4c91",
      "name": "Send to Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.5,
      "position": [672, 0],
      "parameters": { "resource": "message", "operation": "post", "select": "channel", "channelId": { "__rl": true, "mode": "name", "value": "general" }, "messageType": "text", "text": "={{ $json.message }}", "otherOptions": { "includeLinkToWorkflow": false, "mrkdwn": true } }
    }
  ],
  "tags": [],
  "meta": { "aiBuilderAssisted": true, "builderVariant": "mcp" },
  "description": "Fetches a random joke daily at 9am from a public API and posts it to the Slack #general channel with markdown formatting."
}
